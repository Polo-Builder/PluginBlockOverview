{
  "manifest_version": 3,
  "name": "Google sans AI Overview",
  "version": "1.0.1",
  "description": "Force les résultats Web de Google et simplifie sa navigation lorsque le plugin est activé.",
  "minimum_chrome_version": "103",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "privacy"],
  "host_permissions": [
    "*://www.google.com/*", "*://google.com/*",
    "*://www.google.fr/*", "*://google.fr/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["*://www.google.com/*", "*://google.com/*", "*://www.google.fr/*", "*://google.fr/*"],
    "js": ["search-tabs.js"],
    "css": ["search-tabs.css"],
    "run_at": "document_start"
  }],
  "action": { "default_title": "Google sans AI Overview", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
