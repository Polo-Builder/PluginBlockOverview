{
  "manifest_version": 3,
  "name": "EcoWeb",
  "version": "1.0.5",
  "description": "Force les résultats Web de Google en conservant sa navigation native.",
  "minimum_chrome_version": "103",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "privacy"],
  "host_permissions": [
    "*://www.google.com/*", "*://google.com/*",
    "*://www.google.fr/*", "*://google.fr/*"
  ],
  "background": { "service_worker": "build/src/background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["*://www.google.com/search*", "*://google.com/search*", "*://www.google.fr/search*", "*://google.fr/search*"],
    "js": ["build/src/features/BlockOverviewIA/ai-guard.js", "build/src/features/EcoTab/filter-tabs.js"],
    "css": ["src/features/EcoTab/filter-tabs.css"],
    "run_at": "document_start"
  }, {
    "matches": ["http://*/*", "https://*/*"],
    "js": ["build/src/features/AutoDenyCookies/content.js"],
    "run_at": "document_idle",
    "all_frames": true,
    "match_about_blank": true
  }],
  "icons": { "128": "assets/icons/eco-web-rounded.png" },
  "action": { "default_icon": "assets/icons/eco-web-rounded.png", "default_title": "EcoWeb", "default_popup": "src/popup/popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
